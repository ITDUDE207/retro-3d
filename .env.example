# ------------------------------------------------------------------
# GeoWorld 3D Network - environment variables
# Copy to `.env` for local use, or set these in the Vercel dashboard
# (Project -> Settings -> Environment Variables).
# ------------------------------------------------------------------

# Neon Postgres connection string (required in production).
# Neon dashboard -> your project -> Connect -> "Pooled connection" string.
# When unset the app falls back to the local SQLite file (geoworld.db).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob read/write token (required in production so generated .glb
# parcels survive on the read-only serverless filesystem).
# Vercel dashboard -> Storage -> your Blob store -> "Read/Write Token".
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx"

# Optional local overrides.
# PORT=3000
# HOST=0.0.0.0
# GEOWORLD_DB=./geoworld.db
